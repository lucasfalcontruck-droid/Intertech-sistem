generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Platform {
  MERCADO_LIVRE
  SHOPEE
  TIKTOK_SHOP
  VENDEDOR_RUA
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
}

enum OrderStatus {
  PROCESSANDO
  ENVIADO
  ENTREGUE
  CANCELADO
}

enum TransactionType {
  ENTRADA
  SAIDA
}

enum TransactionStatus {
  PENDENTE
  A_VENCER
  PAGO
}

enum FornecedorTipo {
  INSUMO
  PRODUTO
}

enum PedidoCompraStatus {
  AGUARDANDO
  EM_TRANSITO
  RECEBIDO
}

enum CustoTipo {
  FIXO
  VARIAVEL
}

enum InsumoMovimentoTipo {
  ENTRADA
  SAIDA
}

enum DevolucaoStatus {
  SOLICITADA
  EM_ANALISE
  APROVADA
  REEMBOLSADA
}

enum CampanhaStatus {
  ATIVA
  PAUSADA
  ENCERRADA
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("Operador")
  seller       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id        String   @id @default(cuid())
  name      String
  sku       String   @unique
  category  String
  price     Decimal  @db.Decimal(10, 2)
  stock     Int      @default(0)
  minStock  Int      @default(0)
  costPrice Decimal? @db.Decimal(10, 2)
  location  String?
  adViews   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channels   ProductChannel[]
  orderItems OrderItem[]

  @@index([category])
}

model ProductChannel {
  id        String   @id @default(cuid())
  productId String
  platform  Platform
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, platform])
}

model Order {
  id           String      @id @default(cuid())
  number       String      @unique
  customerName String
  platform     Platform
  storeId      String?
  state        String?
  total        Decimal     @db.Decimal(10, 2)
  status       OrderStatus @default(PROCESSANDO)
  createdAt    DateTime    @default(now())

  items OrderItem[]
  store Store?      @relation(fields: [storeId], references: [id])

  @@index([platform])
  @@index([storeId])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

/// Uma conta/loja conectada num canal de venda. Uma mesma plataforma (ex.: Shopee)
/// pode ter várias contas conectadas — uma por CNPJ/loja — daí não ser @unique em platform sozinho.
model Store {
  id            String            @id @default(cuid())
  platform      Platform
  storeName     String
  externalId    String?
  status        IntegrationStatus @default(DISCONNECTED)
  feePercentage Decimal           @db.Decimal(5, 2)
  credentials   Json?
  lastSyncedAt  DateTime?
  /// Visitas do dia mais recente sincronizado (só Mercado Livre por enquanto — ver
  /// lib/marketplace/mercadolivre-client.ts#fetchVisitsToday). Null = nunca sincronizado
  /// ou plataforma sem API de visitas própria ainda.
  visitsToday   Int?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  orders Order[]

  @@unique([platform, externalId])
  @@index([platform])
}

model FinancialTransaction {
  id          String            @id @default(cuid())
  type        TransactionType
  description String
  category    String
  amount      Decimal           @db.Decimal(12, 2)
  dueDate     DateTime
  status      TransactionStatus @default(PENDENTE)
  paidAt      DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([type])
  @@index([status])
  @@index([dueDate])
}

model Cliente {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String
  city      String
  state     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Fornecedor {
  id           String         @id @default(cuid())
  name         String
  tipo         FornecedorTipo
  contact      String
  leadTimeDays Int            @default(0)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  pedidosCompra PedidoCompra[]

  @@index([tipo])
}

model PedidoCompra {
  id           String             @id @default(cuid())
  number       String             @unique
  tipo         FornecedorTipo
  fornecedorId String
  itemName     String
  quantity     Int
  value        Decimal            @db.Decimal(12, 2)
  status       PedidoCompraStatus @default(AGUARDANDO)
  expectedDate DateTime
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id])

  @@index([tipo])
  @@index([status])
}

model CustoItem {
  id        String    @id @default(cuid())
  name      String
  tipo      CustoTipo
  value     Decimal   @db.Decimal(12, 2)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tipo])
}

model Insumo {
  id           String   @id @default(cuid())
  name         String   @unique
  unit         String   @default("un")
  currentStock Int      @default(0)
  minStock     Int      @default(0)
  unitCost     Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  movimentos InsumoMovimento[]
}

model InsumoMovimento {
  id         String              @id @default(cuid())
  insumoId   String
  tipo       InsumoMovimentoTipo
  quantity   Int
  notaFiscal String
  party      String
  value      Decimal             @db.Decimal(12, 2)
  date       DateTime            @default(now())

  insumo Insumo @relation(fields: [insumoId], references: [id], onDelete: Cascade)

  @@index([insumoId])
}

model Devolucao {
  id          String          @id @default(cuid())
  orderNumber String?
  product     String
  reason      String
  platform    Platform
  value       Decimal         @db.Decimal(10, 2)
  status      DevolucaoStatus @default(SOLICITADA)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
}

model Campanha {
  id          String         @id @default(cuid())
  name        String
  platform    Platform
  dailyBudget Decimal        @db.Decimal(10, 2)
  spent       Decimal        @default(0) @db.Decimal(10, 2)
  clicks      Int            @default(0)
  conversions Int            @default(0)
  status      CampanhaStatus @default(ATIVA)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}
